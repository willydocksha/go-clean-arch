# =====================================================================
# copy this file to .env and adjust:  cp .env.example .env
# only DATABASE_URL is required. redis and s3 are optional:
# leave REDIS_ADDR / S3_BUCKET empty and the app still runs.
# =====================================================================

# ---------- app ----------
APP_NAME=go-clean-arch
# development = text logs, production = json logs
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=debug
# default timeout for each usecase call
APP_CONTEXT_TIMEOUT=5s

# ---------- http ----------
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
# comma separated, e.g. http://localhost:3000,https://app.example.com
HTTP_ALLOWED_ORIGINS=*
# max upload size for multipart endpoints (MB)
HTTP_MAX_UPLOAD_MB=10

# ---------- postgres (required) ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/go_clean_arch?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
# run embedded migrations when the api starts
DB_AUTO_MIGRATE=false

# ---------- redis (optional, empty REDIS_ADDR = disabled) ----------
REDIS_ADDR=
# REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# prefix added to every key
REDIS_KEY_PREFIX=go-clean-arch:

# ---------- s3 / minio (optional, empty S3_BUCKET = disabled) ----------
S3_BUCKET=
# S3_BUCKET=go-clean-arch
S3_REGION=ap-southeast-1
# aws: leave empty. minio local: http://localhost:9000
S3_ENDPOINT=
# public host used inside presigned urls (when api runs in docker but browser is outside)
S3_PRESIGN_ENDPOINT=
# leave empty on aws to use the default credential chain (iam role, ~/.aws)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for minio / localstack
S3_FORCE_PATH_STYLE=false
# lifetime of presigned urls
S3_PRESIGN_EXPIRY=15m
# create the bucket on startup (local dev only)
S3_CREATE_BUCKET=false
